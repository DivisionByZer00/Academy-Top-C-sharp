using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using ConsoleApp3;

namespace ConsoleApp3
{
    public class TaskItem
    {
        public string Description { get; set; }
        public bool IsDone { get; set; }

        public TaskItem(string description)
        {
            Description = description;
            IsDone = false;
        }
    }



}

class Program
{
    public static void Main(string[] args)
    {
        List<TaskItem> tasks = new List<TaskItem>();

        while (true)
        {
            Console.WriteLine("\n╔═════════════════════════════╗");
            Console.WriteLine("║        СПИСОК ЗАДАЧ         ║");
            Console.WriteLine("╠═════════════════════════════╣");
            Console.WriteLine("║ 1. Добавить задачу          ║");
            Console.WriteLine("║ 2. Посмотреть задачи        ║");
            Console.WriteLine("║ 3. Отметить как выполненную ║");
            Console.WriteLine("║ 4. Выйти                    ║");
            Console.WriteLine("╚═════════════════════════════╝");
            Console.Write("Выберите действие: ");
            string choice = Console.ReadLine();

            switch (choice)
            {
                case "1":
                    Console.Write("Введите новую задачу: ");
                    string newTask = Console.ReadLine();
                    tasks.Add(new TaskItem(newTask));
                    Console.WriteLine("Задача успешно добавлена!");
                    break;

                case "2":
                    Console.WriteLine("\n--- Текущие задачи ---");
                    if (tasks.Count == 0)
                    {
                        Console.WriteLine("Список задач пуст.");
                    }
                    else
                    {
                        for (int i = 0; i < tasks.Count; i++)
                        {
                            string status = tasks[i].IsDone ? "[X]" : "[ ]";
                            Console.WriteLine($"{i + 1}. {status} {tasks[i].Description}");
                        }
                    }
                    break;

                case "3":
                    Console.WriteLine("\n--- Отметить задачу как выполненную ---");
                    if (tasks.Count == 0)
                    {
                        Console.WriteLine("Список задач пуст.");
                        break;
                    }

                    for (int i = 0; i < tasks.Count; i++)
                    {
                        string status = tasks[i].IsDone ? "[X]" : "[]";
                        Console.WriteLine($"{i + 1}. {status} {tasks[i].Description}");
                    }

                    Console.Write("Введите номер задачи: ");

                    int taskNum = Convert.ToInt32(Console.ReadLine());

                    if (taskNum > 0 && taskNum <= tasks.Count)
                    {
                        tasks[taskNum - 1].IsDone = true;
                        Console.WriteLine($"Задача \"{tasks[taskNum - 1].Description}\" отмечена как выполненная!");
                    }
                    else
                    {
                        Console.WriteLine("Ошибка: неверный номер задачи.");
                    }


        
                    break;

                case "4":
                    Console.WriteLine("Выход из программы...");
                    return;

                default:
                    Console.WriteLine("Ошибка: неверный выбор. Пожалуйста, введите число от 1 до 4.");
                    break;
            }
        }
    }


}
