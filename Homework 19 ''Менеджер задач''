using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Threading.Tasks;
using Newtonsoft.Json;


class Program
{
    static string filePath = "D:\\tasks.txt";
    static List<string> tasks = new List<string>();

    static void LoadTasks()
    {
        if (File.Exists(filePath))
        {
            tasks = new List<string>(File.ReadAllLines(filePath));
        }
        else
        {
            tasks = new List<string>();
        }
    }

    static void SaveTasks()
    {
        File.WriteAllLines(filePath, tasks);
    }

    static void ShowMenu()
    {
        Console.WriteLine("\n--- Менеджер задач ---");
        Console.WriteLine("1. Добавить задачу");
        Console.WriteLine("2. Посмотреть задачи");
        Console.WriteLine("3. Выйти");
        Console.Write("Выберите действие: ");
    }

    static void ShowTasks()
    {
        Console.WriteLine("\n--- Текущие задачи ---");

        if (tasks.Count == 0)
        {
            Console.WriteLine("Список задач пуст.");
            return;
        }

        for (int i = 0; i < tasks.Count; i++)
        {
            Console.WriteLine($"{i + 1}. {tasks[i]}");
        }
    }

    static void AddTask()
    {
        Console.Write("Введите новую задачу: ");
        string newTask = Console.ReadLine();
        tasks.Add(newTask);

        SaveTasks();

        Console.WriteLine("Задача успешно добавлена и сохранена!");
    }

    static void Main(string[] args)
    {
        LoadTasks();

        while (true)
        {
            ShowMenu();
            string choice = Console.ReadLine();

            switch (choice)
            {
                case "1":
                    AddTask();
                    break;
                case "2":
                    ShowTasks();
                    break;
                case "3":
                    Console.WriteLine("Выход из программы...");
                    return;
                default:
                    Console.WriteLine("Ошибка: выберите 1, 2 или 3.");
                    break;
            }
        }
    }
}
